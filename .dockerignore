# ============================================================
# Docker 构建排除规则（根目录）
# 各子模块可使用独立的 .dockerignore 进一步优化
# ============================================================

# IDE
.idea/
.vscode/
*.iml
*.iws
*.ipr

# 构建产物
target/
build/
out/
*.jar
*.war
*.class

# 日志与临时文件
*.log
logs/
tmp/
temp/
.DS_Store
Thumbs.db

# 依赖
node_modules/
**/node_modules/

# 版本控制
.git/
.gitignore
.gitattributes

# Docker 自身
docker-compose.yml
Dockerfile
.dockerignore

# 文档
*.md
docs/
设计/

# 环境变量
.env
.env.*

# 数据库导出（防止敏感信息进入镜像）
*.sql.gz
*.dump

# 系统文件
*.swp
*.swo
*~
